# Tool A, A1 (docs/progetto-strumento-a-base.md §1): the executor of the order receiver. Root, minimal: a local
# UNIX socket only (/run/domhouse-agent, root:domhouse-agent 750; socket 660), served to the reader's uid alone.
# Installed by scripts/agent-vm.sh install; never by hand.
[Unit]
Description=DOMHOUSE agent: executor of the orders (root, local socket only)
After=docker.service
Wants=docker.service

[Service]
Type=simple
User=root
Group=domhouse-agent
ExecStart=/usr/bin/python3 -I /opt/domhouse/agent/esecutore.py
RuntimeDirectory=domhouse-agent
RuntimeDirectoryMode=0750
StateDirectory=domhouse-executor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
# R7: A1 only reads (stato, capienza): the whole system read-only but its StateDirectory and RuntimeDirectory, and
# no capability. A2 (crea_motore) will open exactly what it writes. Da verificare sulla VM: «docker inspect» works
# without capabilities (the socket /run/docker.sock is root's: owner, no DAC override needed)
ProtectSystem=strict
# A3 (docs/proposta-a3-server.md §6.1, N9): aggiorna_broker writes devices/<apt> and broker-vm.sh sync rewrites auth/
# (root:1883 750, files 1883:1883 640): CAP_CHOWN to give the new files to 1883, and the broker's group to re-read them.
# A2 (docs/proposta-a2.md §4.2, review point 4, N3): crea_motore and togli_motore write the engines' files
# (/opt/domhouse: settings and the VM's lock; /etc/domhouse: key, catalog; /data/<apt>): CAP_CHOWN gives the data
# folder to the engine's user 10001, CAP_DAC_OVERRIDE lets root empty /data/<apt> (10001, 750) when it takes an
# engine back. Writes stay closed by ProtectSystem=strict and these three paths alone. Da verificare sulla VM con
# systemd-run e le stesse impostazioni (procedura di installazione di A2) prima di installare
ReadWritePaths=/opt/domhouse /etc/domhouse /data
# code review A2, point 2: inside those paths, the agent's code, the scripts root runs, the compose files, the agent's
# configuration and keys, the approved image and the broker's data stay read only (the most specific path wins;
# «-» = no error when the file does not exist yet)
ReadOnlyPaths=/opt/domhouse/agent /opt/domhouse/engine-vm.sh /opt/domhouse/broker-vm.sh /opt/domhouse/broker_accounts.py -/opt/domhouse/compose.yaml -/opt/domhouse/compose.catalog.yaml -/opt/domhouse/compose.broker.yaml -/opt/domhouse/_broker /etc/domhouse/agent.conf -/etc/domhouse/agent-ordini.key -/etc/domhouse/agent-risultati.key -/etc/domhouse/agent-immagine-staging -/etc/domhouse/agent-immagine-prod -/data/_broker
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE
AmbientCapabilities=
# the group by name (systemd refuses a gid no group has: 20 November); agent-vm.sh install makes it with gid 1883
SupplementaryGroups=domhouse-broker
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
LockPersonality=yes
# code review A2, point 8: crea_motore runs docker login, compose pull and up from here: room for them (C4, C9.2)
MemoryMax=512M
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
