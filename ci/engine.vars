# The engine's environment for the conformance suite: ONE source for the CI (.github/workflows/conformita.yml, also
# docker run --env-file) and for the PC run (scripts/run_tests.py, step 0). Each place adds only what differs there:
# HOST, PORT and DATA_DIR (a fresh temporary folder: engine.db must start empty). KEY=VALUE lines, no quotes.
# API_KEY is not a secret: it opens only the engine started by the test, on 127.0.0.1.
APARTMENT_ID=apt-ci-01
API_KEY=ci-engine-key-not-secret
CONNECTOR=simulated
MOCK_TIME_SCALE=1
