# Sviluppo locale: copia in frontend/.env
VITE_BFF_URL=http://localhost:8000
VITE_AUTH_MODE=dev
VITE_FCM_ENABLED=false

# Produzione: copia in frontend/.env.production (non committato). VITE_BFF_URL lo imposta scripts/deploy.sh.
# I valori VITE_FIREBASE_* sono quelli dell'app web nella console Firebase (Impostazioni progetto > Le tue app):
# non sono segreti, ma restano fuori dal repository.
# VITE_AUTH_MODE=firebase
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# Solo con le notifiche push attive (FCM_ENABLED=true sul BFF):
# VITE_FCM_ENABLED=true
# VITE_FIREBASE_VAPID_KEY=
