# Copia in bff/.env per lo sviluppo locale (make dev). Nessun segreto reale qui.
APP_ENV=dev
AUTH_MODE=dev
INSTANCE_MODE=mock
REPOSITORY=memory
FCM_ENABLED=false
PORT=8000
BFF_ROOT_PATH=

# Chiave usata dal mock integrato (INSTANCE_MODE=mock): qualsiasi stringa, uguale da entrambi i lati.
INSTANCE_API_KEY_FALLBACK=dev-key
MOCK_TIME_SCALE=1

# Solo con REPOSITORY=firestore / AUTH_MODE=firebase / INSTANCE_MODE=real.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west8
FIREBASE_PROJECT_ID=your-gcp-project-id
SECRET_MANAGER_PREFIX=langbrain-api-key-
INSTANCE_TIMEOUT_S=10

# Origini della PWA ammesse fuori da dev, separate da virgola (in dev è sempre *).
CORS_ORIGINS=

# Webhook Italianway: HMAC-SHA256 sul body grezzo. In produzione arriva da Secret Manager.
ITALIANWAY_WEBHOOK_SECRET=replace-me
ITALIANWAY_SIGNATURE_HEADER=X-Signature

# Email di invito (SMTP su SSL). Vuoto = invito solo registrato, nessuna email. Mai una password reale qui.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
APP_PUBLIC_URL=http://localhost:5173
